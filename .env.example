# Copy to .env.local and fill in from: firebase apps:sdkconfig WEB <your-web-app-id>
# The Firebase web config is public by design (it identifies the project; App Check protects it).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# App Check (required by Firebase AI Logic).
# Production: a reCAPTCHA Enterprise SCORE key whose allowed domains include your hosting domain.
VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=

# Development only: put this in .env.development.local (Vite never loads it for production builds).
# Create and register one with: firebase appcheck:debugtokens:create --app <your-web-app-id>
# VITE_APPCHECK_DEBUG_TOKEN=
